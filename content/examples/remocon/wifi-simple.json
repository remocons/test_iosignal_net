{
  "title": "WiFi 공유 스위치 수신",
  "kind": "group",
  "summary": "#switch 그룹에 참여해 공유 상태를 시리얼로 출력합니다. 하드웨어 없이 통신만 확인하는 가장 간단한 예제입니다. LED_PIN을 켜면 s1 값으로 LED도 켭니다.",
  "boards": [
    {
      "name": "ESP8266 D1 mini",
      "fqbn": "esp8266:esp8266:d1_mini"
    },
    {
      "name": "ESP32 개발 보드",
      "fqbn": "esp32:esp32:esp32"
    },
    {
      "name": "ESP32-C3 Super Mini",
      "fqbn": "esp32:esp32:esp32c3"
    }
  ],
  "network": "Wi-Fi 2.4GHz 공유기",
  "app": "https://remocon.kr 또는 IOSignal Desktop 장치 제어 화면",
  "partners": [],
  "wiring": [
    {
      "pin": "LED_PIN (선택)",
      "part": "LED",
      "note": "active low. 스케치의 LED_PIN 주석을 풀면 s1 값으로 켭니다. ESP32-C3 Super Mini는 내장 LED GPIO8입니다."
    }
  ],
  "setup": [
    "스케치의 WiFi 이름과 비밀번호를 실제 값으로 바꿉니다.",
    "스케치를 업로드하고 시리얼 모니터 115200을 엽니다.",
    "같은 공유기에 연결한 브라우저로 https://remocon.kr 을 엽니다.",
    "공유 스위치를 눌러 시리얼에 s1=1 같은 값이 나오는지 봅니다."
  ],
  "flow": [
    {
      "from": "장치",
      "to": "서버",
      "tag": "#switch$state",
      "value": "구독",
      "note": "공유 상태를 구독합니다. 보관된 값이 있으면 바로 받습니다."
    },
    {
      "from": "장치",
      "to": "서버",
      "tag": "#search",
      "value": "구독",
      "note": "앱의 검색 요청을 받도록 구독합니다."
    },
    {
      "from": "장치",
      "to": "서버",
      "tag": "#switch$info",
      "value": "n=공유 스위치;t=switch3.1",
      "note": "그룹 정보입니다. 서버에 보관됩니다."
    },
    {
      "from": "장치",
      "to": "앱",
      "tag": "#notify",
      "value": "#switch",
      "note": "그룹은 CID 대신 채널 이름으로 알립니다."
    },
    {
      "from": "앱",
      "to": "장치",
      "tag": "#search",
      "note": "앱이 그룹을 찾습니다."
    },
    {
      "from": "장치",
      "to": "앱",
      "tag": "#notify",
      "value": "#switch",
      "note": "구성원마다 답하고 앱은 하나로 합칩니다."
    },
    {
      "from": "앱",
      "to": "장치",
      "tag": "#switch$state",
      "value": "s1=1;s2=0;s3=0",
      "note": "앱이 전체 문자열을 다시 씁니다. 구성원은 자기 키를 읽습니다."
    }
  ],
  "notes": [
    "기본은 값을 출력만 하고 핀은 제어하지 않습니다.",
    "esp32c3/esp32c3-simple 예제를 합쳤습니다. 보드 제품마다 핀 번호가 다를 수 있습니다."
  ],
  "library": "remocon",
  "name": "wifi-simple",
  "draft": false,
  "approved": true,
  "source": "https://github.com/remocons/remocon-arduino/tree/main/examples/wifi-simple",
  "sketch": "https://github.com/remocons/remocon-arduino/blob/main/examples/wifi-simple/wifi-simple.ino",
  "media": []
}
